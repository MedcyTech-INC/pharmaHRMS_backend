# ====================================================================
# PHARMA HRMS BACKEND - DOCKER ENVIRONMENT CONFIGURATION
# ====================================================================

# Port mapping on your host machine (8088 is verified free on VPS)
APP_PORT=8088

# Application Settings
APP_NAME="Orca Labs Pharma HRMS"
DEBUG=False

# Database Connection
# 1) If using external/cloud Supabase:
#    DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# 2) If using Postgres on the VPS host (outside docker):
#    DATABASE_URL=postgresql+asyncpg://hrms:password@host.docker.internal:5432/pharma_hrms
# 3) If using docker-compose --profile with-db:
#    DATABASE_URL=postgresql+asyncpg://hrms:password@db:5432/pharma_hrms
DATABASE_URL=postgresql+asyncpg://hrms:your_db_password_here@localhost:5432/pharma_hrms

# Redis Connection
# If using docker-compose redis: redis://redis:6379
# If using VPS host redis: redis://host.docker.internal:6379
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Generate secure random 32+ character strings)
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage & Realtime
SUPABASE_URL=https://your-supabase-url.example.com
SUPABASE_KEY=your_supabase_service_or_anon_key_here
VITE_SUPABASE_URL=https://your-supabase-url.example.com
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional Local Database (When using docker-compose with-db profile)
DB_NAME=pharma_hrms
DB_USER=hrms
DB_PASSWORD=password
DB_PORT=5432
REDIS_PORT=6379
